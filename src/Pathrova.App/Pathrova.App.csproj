<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Pathrova</AssemblyName><RootNamespace>Pathrova.App</RootNamespace><Version>1.0.0</Version><Product>Pathrova</Product><Company>Minh Studios</Company>
    <Description>Pathrova – Pfade vor der Cloud-Migration prüfen</Description><BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon Condition="Exists('Assets/app.ico')">Assets/app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup><AvaloniaResource Include="Assets/**" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" /><PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" /><PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../Pathrova.Core/Pathrova.Core.csproj" /></ItemGroup>
</Project>
